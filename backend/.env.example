# ===== Thai Thai Massage — Backend (Go) =====
PORT=8080

# Supabase: Project Settings → Database → Connection string
# แนะนำ "Session pooler" (port 5432) หรือ Direct connection
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# ถ้าใช้ "Transaction pooler" (port 6543) ให้ตั้งเป็น true (ไม่รองรับ prepared statements)
DB_SIMPLE_PROTOCOL=false

# สุ่มยาว ≥ 32 ตัวอักษร เช่น: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_TTL=12h

# บัญชีเจ้าของร้าน (สร้างอัตโนมัติครั้งแรกเมื่อยังไม่มีผู้ใช้ในระบบ) — เปลี่ยนรหัสผ่านหลังเข้าสู่ระบบครั้งแรก
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=เจ้าของร้าน

# โดเมนของหน้าเว็บที่อนุญาตให้เรียก API (คั่นด้วย ,)
ALLOWED_ORIGINS=http://localhost:5173

SHOP_TIMEZONE=Asia/Bangkok

# (ไม่บังคับ) เสิร์ฟหน้าเว็บจาก Go server เดียวกัน: ชี้ไปที่ frontend/dist
STATIC_DIR=

# (ไม่บังคับ) ถ้าตั้งไว้ Botnoi ที่ส่ง header X-API-Key ต้องส่งค่านี้ให้ตรง
BOT_API_KEY=

# ตั้ง true เมื่ออยู่หลัง reverse proxy (Render, Fly, Nginx) เพื่ออ่าน IP จริงจาก X-Forwarded-For
TRUST_PROXY=false
